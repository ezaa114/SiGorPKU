{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && node -e \"const fs = require('fs'); fs.readdirSync('bootstrap/cache').forEach(f => f.endsWith('.php') && fs.unlinkSync('bootstrap/cache/' + f))\"",
        "dev": "vite"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.0.0",
        "autoprefixer": "^10.5.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.3.1",
        "vite": "^8.0.0"
    }
}
